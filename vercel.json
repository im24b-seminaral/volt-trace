{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "nextjs": {
      "root": "nextjs",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "python",
          "format": "url",
          "env": "VOLT_TRACE_PYTHON_URL"
        }
      ]
    },
    "python": {
      "root": "python",
      "runtime": "python",
      "entrypoint": "volt_trace.api:app"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "nextjs" }
    }
  ]
}
